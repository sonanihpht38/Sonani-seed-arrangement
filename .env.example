# =============================================================================
# Root env for docker-compose. Copy to `.env`:  cp .env.example .env
# Compose passes this to the api/worker/beat containers (env_file) and uses
# DB_PASSWORD for the SQL Server container.
# =============================================================================

# --- Django ---
DJANGO_ENV=production
DEBUG=false
SECRET_KEY=change-me-generate-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,api,web
LOG_JSON=true
LOG_LEVEL=INFO
# The proxy terminates TLS in real deployments; disable redirect for local http.
SECURE_SSL_REDIRECT=false

# --- Database (SQL Server) ---
# MSSQL requires a strong SA password (>=8 chars, upper/lower/digit/symbol).
DB_NAME=sonani
DB_USER=sa
DB_PASSWORD=Your_Strong_Passw0rd!
DB_PORT=1433

# --- DRF throttling / pagination ---
DRF_PAGE_SIZE=25
THROTTLE_USER=1000/hour
THROTTLE_ANON=60/hour
THROTTLE_LOGIN=10/min
# Job-status polling has its OWN budget and does not draw on THROTTLE_USER.
# The Result screen polls until an arrangement finishes, which can be half an
# hour; charging that to the user bucket exhausted it mid-run and then refused
# every other endpoint — including /me — so a signed-in user could not open the
# app at all. Only lower this if a client is misbehaving.
THROTTLE_JOB_POLL=6000/hour

# --- JWT ---
ACCESS_TOKEN_LIFETIME_MIN=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# --- CORS / CSRF (add your real web origin) ---
CORS_ALLOWED_ORIGINS=http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080

# --- gunicorn sizing ---
WEB_CONCURRENCY=4
GUNICORN_THREADS=4

# --- Plate arrangement ---
# Seconds a plate-arrangement job may run before the Celery worker kills it.
# Deliberately far above CELERY_TASK_TIME_LIMIT (300 s), which is sized for the
# short email/export tasks: Max Coverage packs every plate 20 times and a
# Compare run over many plates takes minutes. A job killed by the limit shows in
# the UI as one stuck at "running" that never finishes.
#
# If runs are routinely slow, the fix is the seed-width band on the Criteria
# screen, not a bigger number here — narrowing it cut a live run from 36 plates
# to 8 and raised coverage at the same time.
PRODUCTION_JOB_TIME_LIMIT=7200

# --- Observability (optional) ---
# SENTRY_DSN=
GRAFANA_PASSWORD=admin
