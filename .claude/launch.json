{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sonani-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "react-frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5175",
        "--strictPort"
      ],
      "port": 5175,
      "autoPort": false
    },
    {
      "name": "backend",
      "runtimeExecutable": "django-backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "django-backend/manage.py",
        "runserver",
        "8001"
      ],
      "port": 8001
    }
  ]
}