# ============================================================================
# Sonani (Django) — environment template. Copy to `.env` and fill in.
# Never commit the real .env. In containers, real env vars override this file.
# ============================================================================

# --- Environment selector: development | production -------------------------
DJANGO_ENV=development

# --- Core -------------------------------------------------------------------
# Turn DEBUG off the moment this stack is reachable from anything but localhost:
# the traceback page prints SECRET_KEY and DB_PASSWORD to whoever triggers a 500.
DEBUG=true
SECRET_KEY=change-me-generate-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Let the app serve MEDIA_ROOT (the production module's plate images). Defaults
# to DEBUG in development; set it explicitly when running dev with DEBUG=false,
# or the images 404. Leave OFF in a real deployment — nginx serves /media there.
# SERVE_MEDIA=true

# --- Database ---------------------------------------------------------------
# DB_ENGINE=sqlite (default, zero-setup) | mssql (SQL Server, production)
DB_ENGINE=sqlite

# SQL Server settings (used only when DB_ENGINE=mssql):
DB_NAME=sonani
DB_USER=sa
DB_PASSWORD=Your_Strong_Passw0rd!
DB_HOST=db
DB_PORT=1433
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
DB_EXTRA_PARAMS=Encrypt=yes;TrustServerCertificate=yes
# Seconds a physical DB connection is kept alive & reused across requests.
DB_CONN_MAX_AGE=60

# --- Cache / sessions / Celery broker (Redis) -------------------------------
# Leave REDIS_URL empty for local in-memory cache (no Redis needed).
REDIS_URL=redis://redis:6379/0
CACHE_KEY_PREFIX=sonani
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- DRF: pagination + throttling -------------------------------------------
DRF_PAGE_SIZE=25
THROTTLE_USER=1000/hour
THROTTLE_ANON=60/hour
THROTTLE_LOGIN=10/min

# --- JWT lifetimes (minutes / days) -----------------------------------------
ACCESS_TOKEN_LIFETIME_MIN=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# --- CORS / CSRF — the React origin -----------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# --- Email (SMTP) — used by password reset ----------------------------------
# Leave EMAIL_HOST empty to print emails (incl. the reset link) to the server
# console instead of sending them — handy for local dev with no SMTP server.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=Sonani Seed Arrangement <no-reply@sonani.local>
# Base URL of the React app — used to build the reset link in the email.
FRONTEND_URL=http://localhost:5173
# Password-reset token lifetime in seconds (default 30 min).
PASSWORD_RESET_TIMEOUT=1800

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
# JSON logs for production collectors; set false for readable local console logs.
LOG_JSON=false

# --- gunicorn (production) --------------------------------------------------
WEB_CONCURRENCY=4
GUNICORN_THREADS=4

# --- Production-only ---------------------------------------------------------
SECURE_SSL_REDIRECT=true
# SENTRY_DSN=
# RELEASE_VERSION=
